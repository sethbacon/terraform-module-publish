{
  "name": "terraform-module-publish",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action: publish a Terraform/OpenTofu module version to a self-hosted registry or HCP Terraform / TFE.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify --no-source-map-register && npm run verify:bundle",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "vitest run --coverage",
    "test:dist": "node scripts/dist-behaviour.mjs",
    "lint": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@4cloudguru/pipeline-task-core": "^0.5.0",
    "@actions/core": "^1.11.1",
    "undici": "^6.28.0"
  },
  "overrides": {
    "undici": "$undici"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
