{
  "compilerOptions": {
    "target": "ES2021",
    // Was `commonjs` / `node` (i.e. node10). TypeScript 7 removed node10
    // resolution outright — `error TS5108` — so this had to move, and where it
    // moved to is decided by @actions/core 3.x being ESM-only.
    //
    // `node16` models Node 16, which cannot `require()` an ES module, so it
    // rejects src/index.ts's `import * as core from '@actions/core'` with
    // TS1479 and would force this action to become ESM for no runtime reason.
    // `node20` models `require(esm)`, which is what the node24 runtime this
    // action declares in action.yml actually does. Pinned rather than
    // `nodenext`, which re-points at whatever is newest on every TypeScript
    // bump and would change the type-check under a Dependabot PR.
    //
    // These describe how the SOURCE is checked, not what ships: nothing emits
    // from tsc (`lint` is --noEmit), and esbuild reads only `target` from here.
    // dist/ stays CommonJS because the build line says `--format=cjs`.
    "module": "node20",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
